# Ingenium AI — copy to .env and fill in. NEVER commit .env.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string

# development | production   (tests force "testing")
APP_ENV=development
FLASK_DEBUG=1

# PostgreSQL (psycopg 3 driver is selected automatically; postgres:// URLs are accepted)
DATABASE_URL=postgresql://ingenium:change-this-password@localhost:5432/ingenium_db
# Separate database for pytest — never point this at real data
TEST_DATABASE_URL=postgresql://ingenium:change-this-password@localhost:5432/ingenium_test

# Private file storage (resumes, employee documents, offer letters). Must NOT be inside frontend/static.
# Leave blank to use instance/uploads
UPLOAD_FOLDER=
MAX_UPLOAD_MB=5
ENABLE_OCR=0

# Local AI (Ollama)
AI_ENABLED=1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Only for a remote, secured Ollama proxy (sent as a Bearer token)
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=90
OLLAMA_MAX_RETRIES=1
OLLAMA_MAX_CONCURRENCY=2
AI_MAX_INPUT_CHARS=6000

# Sessions
SESSION_HOURS=8
SESSION_COOKIE_SECURE=0

# Optional email (password reset / verification). Leave MAIL_SERVER blank to disable.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_FROM=no-reply@example.com

# Misc
LOGIN_RATE_LIMIT=10/300
OFFER_REQUIRE_SEPARATE_APPROVER=0
LOG_LEVEL=INFO

# Docker only (docker compose up). The container gets its own PostgreSQL with this password;
# DATABASE_URL above is ignored inside Docker. SECRET_KEY above must be strong (32+ random chars).
POSTGRES_PASSWORD=
# Where the container finds Ollama; default reaches Ollama running on this computer.
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
